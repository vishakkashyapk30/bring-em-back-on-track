# Copy to .env (gitignored). The offline LLM provider is the default and needs no key.
LLM_PROVIDER=offline            # offline | gemini | ollama
GEMINI_API_KEY=
GEMINI_MODEL=TBC
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=TBC

USE_FIXTURES=true               # API serves api/fixtures until modules are real
SESSION_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:5173

C360_DUCKDB_MEMORY=8GB
