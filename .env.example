# Copy to .env (gitignored). The offline LLM provider is the default and needs no key.
# Ask understands unseen wording with a language model when LLM_PROVIDER is not offline (rules stay the safety net).
# Measured on 24 unseen questions (eval/llm_rewrite_eval.py): mistral:latest picks the right metric on 12 of 15 and
# declines 9 of 9; gemma3:4b 11 of 15; llama3.2 4 of 15. Needs `ollama pull mistral` and `uv sync --extra llm` for gemini.
LLM_PROVIDER=offline            # offline | gemini | deepseek | ollama
LLM_FALLBACK=ollama            # tried when the primary is down or over quota; then the deterministic rules
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:latest
GEMINI_API_KEY=                 # Google AI Studio key, only if LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
LLM_MIN_INTERVAL_SEC=6.5         # seconds between cloud calls; use 0.5 on a paid plan
OPENAI_API_KEY=                 # only if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=              # only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
DEEPSEEK_API_KEY=               # only if LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat

USE_FIXTURES=true               # API serves api/fixtures until modules are real
SESSION_SECRET=dev-only-change-me
CORS_ORIGINS=http://localhost:5173

C360_DUCKDB_MEMORY=8GB
